{
  "name": "bootstrap-atlas",
  "private": true,
  "version": "3.0.0",
  "description": "Bootstrap Atlas Web Development Studio",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install && npm run install:bootstrap",
    "install:bootstrap": "node scripts/install-bootstrap.mjs",
    "dev": "concurrently -k -n WEB,API -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @atlas/web",
    "dev:api": "npm run dev --workspace @atlas/api",
    "dev:angular": "npm run start --prefix apps/angular",
    "build": "npm run build --workspace @atlas/web",
    "build:angular": "npm run build --prefix apps/angular",
    "test": "npm run test --workspace @atlas/api",
    "check": "npm run typecheck --workspace @atlas/web && npm run test",
    "preview": "npm run preview --workspace @atlas/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
